{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelbox",
  "version": "0.1.0",
  "identifier": "dev.reelbox.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Reelbox",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
