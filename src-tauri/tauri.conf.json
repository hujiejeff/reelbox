{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reelbox",
  "version": "0.1.0",
  "identifier": "dev.reelbox.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "appDirectoriesOverride": {
      "config": "$CONFIG/reelbox"
    },
    "windows": [
      {
        "title": "Reelbox",
        "width": 1000,
        "height": 640,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}